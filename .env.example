# Backend environment variables (example). Set real values in the Railway dashboard -- never commit secrets. See RAILWAY_SETUP.md.

# --- Database (REQUIRED for boot) ---
# Railway: link the PostgreSQL service (Settings -> Link Variable) -> auto-injects DATABASE_URL.
# Supabase pooler example (transactional pooler, port 6543, sslmode=require):
DATABASE_URL=postgresql://postgres.wniithuksxbmmgqsyseu:YOUR-SUPABASE-PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require

# --- JWT ---
JWT_SECRET=replace-with-a-64-char-random-string-openssl-rand-base64-64
JWT_EXPIRATION_MS=86400000

# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_PLAN_AFFILIATE=PLN_your_affiliate_plan
PAYSTACK_PLAN_ASSOCIATE=PLN_your_associate_plan
PAYSTACK_PLAN_MEMBER=PLN_your_member_plan

# --- Email (sent via Brevo HTTPS REST API -- Railway blocks outbound SMTP) ---
BREVO_API_KEY=key_your_brevo_api_key
MAIL_SENDER_EMAIL=suragees@gmail.com
MAIL_SENDER_NAME=GNSW

# --- Frontend callback origins (exact deployed URLs, no trailing slash) ---
MAIN_SITE_URL=https://www.gnsw.ng
ADMIN_URL=https://admin.gnsw.ng
MEMBER_PORTAL_URL=https://members.gnsw.ng

# --- Misc ---
SERVER_PORT=8080
JPA_DDL_AUTO=validate
